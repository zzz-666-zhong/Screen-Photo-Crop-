<Window x:Class="Crop.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Crop.Desktop" Title="切屏 · 批量裁剪工作台" Width="1460" Height="920" MinWidth="1180" MinHeight="760" Foreground="{StaticResource Ink}" Background="#F5F5EF" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Window.Resources><local:ThumbConverter x:Key="Thumb"/><local:BoundaryThumbConverter x:Key="BoundaryThumb"/><local:StateBrushConverter x:Key="StateBrush"/></Window.Resources>
 <Grid Background="#F5F5EF">
  <Grid.ColumnDefinitions><ColumnDefinition Width="266"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#252E29" Padding="22,28,22,20">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="切 屏" FontSize="27" FontWeight="SemiBold" Foreground="#F3F4EC"/>
     <TextBlock Text="SCREEN CROP / 01" Margin="0,5,0,30" FontSize="10" Foreground="#A8B2A7"/>
     <Button Content="＋  新建批次" Click="New_Click" HorizontalContentAlignment="Left" Background="#35463A" Foreground="White" BorderThickness="0" Margin="0,0,0,8"/>
     <Button Content="打开已有批次" Click="Open_Click" Background="Transparent" Foreground="#D6DED2" BorderBrush="#526052"/>
     <Border Height="1" Background="#485448" Margin="0,26,0,24"/>
     <TextBlock Text="批次设置" Foreground="#B8C2B6" FontSize="11" Margin="0,0,0,15"/>
     <StackPanel x:Name="SetupPanel">
      <TextBlock Text="原照片目录" Foreground="#D6DED2" Margin="0,0,0,7"/>
      <TextBox x:Name="SourceBox" AllowDrop="True" Drop="Path_Drop" ToolTip="拖入照片文件夹，或点击浏览"/>
      <Button Content="浏览原照片" Click="Source_Click" Padding="8,7" Margin="0,7,0,18" Background="#354039" Foreground="#D6DED2" BorderThickness="0"/>
      <TextBlock Text="结果目录" Foreground="#D6DED2" Margin="0,0,0,7"/>
      <TextBox x:Name="OutputBox"/>
      <Button Content="浏览结果位置" Click="Output_Click" Padding="8,7" Margin="0,7,0,20" Background="#354039" Foreground="#D6DED2" BorderThickness="0"/>
      <CheckBox x:Name="SquareBox" Content="目标图片为正方形" IsChecked="True" Foreground="#D6DED2" Margin="0,0,0,12"/>
      <CheckBox x:Name="RecursiveBox" Content="包含子文件夹" Foreground="#D6DED2" Margin="0,0,0,20"/>
      <TextBlock Text="导出尺寸" Foreground="#D6DED2" Margin="0,0,0,7"/>
      <ComboBox x:Name="SizeBox" SelectedIndex="0" Margin="0,0,0,16"><ComboBoxItem Content="保留原生裁剪分辨率" Tag="0"/><ComboBoxItem Content="128 × 128" Tag="128"/><ComboBoxItem Content="256 × 256" Tag="256"/><ComboBoxItem Content="400 × 400" Tag="400"/><ComboBoxItem Content="512 × 512" Tag="512"/></ComboBox>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="四边内切 / 原图像素" Foreground="#D6DED2" VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="InsetBox" Grid.Column="1" Text="0"/></Grid>
     </StackPanel>
     <TextBlock x:Name="LockedHint" Text="本批参数已锁定。&#10;新建批次可选择新的目录与参数。" Foreground="#A8B2A7" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed" FontSize="11"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="本地处理 · 不依赖模型" Foreground="#D6DED2" FontSize="11"/><TextBlock Text="逐图定位，整批运行，疑难集中复核。" Foreground="#9DAA9B" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="批量裁剪工作台" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="把时间留给疑难照片" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ResultsButton" Content="打开结果" Click="Results_Click" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="RunButton" Content="开始整批处理  →" Click="Run_Click" Style="{StaticResource Primary}"/><Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Visibility="Collapsed"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Margin="0,24,0,18" Padding="22,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="批次照片" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TotalText" Text="—" FontSize="28" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="自动通过" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="AutoText" Text="0" FontSize="28" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="等待复核" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ReviewText" Text="0" Foreground="#B36A20" FontSize="28" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="人工确认 / 失败" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ConfirmedText" Text="0 / 0" FontSize="28" Margin="0,6,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="FilterBox" Width="130" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,10,0"><ComboBoxItem Content="全部照片"/><ComboBoxItem Content="待复核"/><ComboBoxItem Content="自动通过"/><ComboBoxItem Content="人工确认"/><ComboBoxItem Content="处理失败"/><ComboBoxItem Content="未处理"/><ComboBoxItem Content="已排除"/></ComboBox>
    <Grid Grid.Column="1"><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="按文件名搜索"/><TextBlock Text="搜索文件名…" Margin="10,0" VerticalAlignment="Center" FontSize="11" Foreground="#90958B" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="RetryButton" Content="重试失败" Click="Retry_Click" Padding="12,8" Margin="0,0,8,0"/><Button Content="选择本页" Click="SelectPage_Click" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="AcceptSelectedButton" Content="确认所选" Click="AcceptSelected_Click" Padding="12,8"/><Button x:Name="BackButton" Content="返回总览" Click="Back_Click" Padding="12,8" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel>
   </Grid>
   <Grid Grid.Row="3">
    <Grid x:Name="OverviewPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="PhotoGrid" HorizontalContentAlignment="Stretch" VerticalAlignment="Top"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,12" ClipToBounds="True" VerticalAlignment="Top">
         <Grid><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button Background="#E8EAE2" BorderThickness="0" Padding="0" Click="Photo_Click" Tag="{Binding}" ToolTip="原图与四角边界；右下角为裁剪预览。点击调整。"><Grid><Image Source="{Binding BoundaryKey, Converter={StaticResource BoundaryThumb}}" Stretch="Uniform"/><Border Width="58" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="White" BorderBrush="White" BorderThickness="2" CornerRadius="3"><Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumb}}" Stretch="Uniform"/></Border></Grid></Button>
          <StackPanel Grid.Row="1" Margin="12,10,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/></Grid>
           <TextBlock Text="{Binding StatusText}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" FontSize="10" Margin="22,6,0,0"/><TextBlock Text="{Binding Reason}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="22,4,0,0" Height="15" ToolTip="{Binding Reason}"/>
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <Border x:Name="EmptyPanel" Background="#ECEEE5" CornerRadius="9" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel MaxWidth="420"><TextBlock x:Name="EmptyTitle" Text="让一整批照片自己跑完" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="EmptyDetail" Text="选择左侧原照片和结果目录，点击开始整批处理。可靠结果自动导出，疑难照片集中复核。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="25" Margin="0,14,0,0"/><TextBlock Text="01  选择目录       02  整批运行       03  集中复核" FontSize="11" Foreground="#58654E" Margin="0,24,0,0"/></StackPanel></Border>
     <Grid Grid.Row="1" Margin="0,8,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageInfo" Text="尚未导入照片" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="上一页" Click="PrevPage_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="下一页" Click="NextPage_Click" Padding="12,7"/></StackPanel></Grid>
    </Grid>
    <Grid x:Name="EditorPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
     <Border Background="#1E2624" CornerRadius="9" Margin="0,0,16,0" ClipToBounds="True"><Grid><local:CornerSurface x:Name="Surface"/><Border Background="#DD25312C" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" CornerRadius="5" Padding="10,7"><TextBlock x:Name="EditorName" Foreground="#E4E9DE" FontSize="11"/></Border><TextBlock Text="滚轮缩放 · 中键平移 · 拖动角点 · 点击重选四角" Foreground="#CBD4C5" FontSize="10" VerticalAlignment="Bottom" Margin="16"/></Grid></Border>
     <Border Grid.Column="1" Background="White" CornerRadius="9" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="裁剪预览" FontWeight="SemiBold" FontSize="16"/><Border Background="#EEF0E8" CornerRadius="6" Margin="0,14,0,10" Height="210"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border><TextBlock x:Name="PreviewInfo" Text="选满四角后生成预览" FontSize="10" Foreground="{StaticResource Muted}"/>
        <Border Background="#F7F0E5" CornerRadius="6" Margin="0,18,0,14" Padding="12"><TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="#8E632F" FontSize="11" LineHeight="19"/></Border>
        <TextBlock Text="仅修改目标图片的四角。&#10;保留照片中的真实拖影和暗色内容。" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="19"/>
       </StackPanel>
       <StackPanel Grid.Row="2"><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="重新识别" Click="Detect_Click" Padding="8,9" Margin="0,0,4,0"/><Button Grid.Column="1" Content="适应窗口" Click="Fit_Click" Padding="8,9" Margin="4,0,0,0"/></Grid><Button x:Name="SaveNextButton" Content="确认保存并下一张  ↵" Click="SaveNext_Click" Style="{StaticResource Primary}" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="暂时跳过" Click="Skip_Click" Padding="8,9" Margin="0,0,4,0"/><Button Grid.Column="1" Content="标记拍摄失败" Click="Reject_Click" Padding="8,9" Margin="4,0,0,0"/></Grid></StackPanel>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <StackPanel Grid.Row="4" Margin="0,18,0,0"><ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="100" Foreground="#768964" Background="#E1E5D9" BorderThickness="0"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLine" Text="就绪 · 原照片保留" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="ElapsedText" Foreground="{StaticResource Muted}" FontSize="10"/></Grid></StackPanel>
  </Grid>
 </Grid>
</Window>
